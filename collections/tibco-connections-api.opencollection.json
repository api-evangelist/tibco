                "description": "Number of items to skip for pagination"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of items to return"
              }
            ]
          },
          "docs": "Retrieve all configured connector connections for the organization."
        },
        {
          "info": {
            "name": "Create a connection",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.tibco.com/businessevents/v1/connections",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new connector connection with the specified configuration."
        },
        {
          "info": {
            "name": "Get a connection",
            "type": "http"
          },
          "http": {
