              }
            ]
          },
          "docs": "Retrieve details of a specific connection by ID."
        },
        {
          "info": {
            "name": "Delete a connection",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.tibco.com/businessevents/v1/connections/:connectionId",
            "params": [
              {
                "name": "connectionId",
                "value": "",
                "type": "path",
                "description": "Connection unique identifier"
              }
            ]
          },
          "docs": "Delete a connector connection by ID."
