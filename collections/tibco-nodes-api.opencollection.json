{
  "opencollection": "1.0.0",
  "info": {
    "name": "TIBCO BusinessEvents Agents Nodes API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Nodes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List server nodes",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.tibco.com/businessevents/v1/nodes"
          },
          "docs": "Retrieve all Spotfire Server nodes and their status."
        }
      ]
    }
  ],
  "bundled": true
}