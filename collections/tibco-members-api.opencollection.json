{
  "opencollection": "1.0.0",
  "info": {
    "name": "TIBCO BusinessEvents Agents Members API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Members",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List portal members",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.tibco.com/businessevents/v1/rest/members",
            "params": [
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Number of items to skip for pagination"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of items to return"
              },
              {
                "name": "fields",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of fields to include in the response"
              }
            ]
          },
          "docs": "Retrieve all developer portal members."
        },
        {
          "info": {
            "name": "Get a portal member",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.tibco.com/businessevents/v1/rest/members/:memberId",
            "params": [
              {
                "name": "memberId",
                "value": "",
                "type": "path",
                "description": "Member unique identifier"
              },
              {
                "name": "fields",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of fields to include in the response"
              }
            ]
          },
          "docs": "Retrieve details of a specific developer portal member."
        }
      ]
    }
  ],
  "bundled": true
}