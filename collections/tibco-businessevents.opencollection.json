        "name": "Rules",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List business rules",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.tibco.com/businessevents/v1/rules",
            "params": [
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Number of items to skip for pagination"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of items to return"
              }
            ]
          },
          "docs": "Retrieve all business rules defined in the project."
        },
        {
          "info": {
            "name": "Create a business rule",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.tibco.com/businessevents/v1/rules",
