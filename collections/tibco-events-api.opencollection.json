{
  "opencollection": "1.0.0",
  "info": {
    "name": "TIBCO BusinessEvents Agents Events API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Events",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List processed events",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.tibco.com/businessevents/v1/events",
            "params": [
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Number of items to skip for pagination"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of items to return"
              },
              {
                "name": "eventType",
                "value": "",
                "type": "query",
                "description": "Filter by event type"
              },
              {
                "name": "startTime",
                "value": "",
                "type": "query",
                "description": "Filter events after this time"
              },
              {
                "name": "endTime",
                "value": "",
                "type": "query",
                "description": "Filter events before this time"
              }
            ]
          },
          "docs": "Retrieve a list of processed events with optional filters."
        },
        {
          "info": {
            "name": "Submit an event",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.tibco.com/businessevents/v1/events",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Submit a complex event for processing by the inference engine."
        },
        {
          "info": {
            "name": "Get an event",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.tibco.com/businessevents/v1/events/:eventId",
            "params": [
              {
                "name": "eventId",
                "value": "",
                "type": "path",
                "description": "Event unique identifier"
              }
            ]
          },
          "docs": "Retrieve details and processing result of a specific event."
        }
      ]
    }
  ],
  "bundled": true
}